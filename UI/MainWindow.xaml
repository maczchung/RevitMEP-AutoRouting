<Window x:Class="MEPAutoRouting.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MEPAutoRouting.UI"
        xmlns:app="clr-namespace:MEPAutoRouting"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MEP Auto Routing"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg.Editor}"
        Foreground="{DynamicResource Fg.Default}"
        FontFamily="Segoe UI" FontSize="13"
        Topmost="{Binding Topmost}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MEPAutoRouting;component/UI/Themes/VSCodeDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:NoProblemsVisibilityConverter x:Key="NoProblemsVis"/>
            <local:LogLevelBrushConverter x:Key="LevelBrush"/>

            <DataTemplate x:Key="ConnectorCard">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Fg.Bright}"
                               ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                    <TextBlock Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Margin="0,2,0,0">
                        <Run Text="{Binding IdText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding OriginText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="LogLine">
                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" Margin="12,1">
                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{StaticResource Fg.Muted}"/>
                    <Run Text="{Binding LevelText, Mode=OneWay}" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"/>
                    <Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource Fg.Default}"/>
                </TextBlock>
            </DataTemplate>

            <!-- Problem line: Error = red, Warning = yellow -->
            <DataTemplate x:Key="ProblemLine">
                <Grid Margin="12,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Log.Warn}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="#F14C4C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding SeverityText}" Style="{StaticResource Text.Muted}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource Fg.Default}" TextWrapping="Wrap"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Border.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- ================================================================ TITLE BAR -->
            <Border Grid.Row="0" Background="{StaticResource Bg.Title}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/MEPAutoRouting;component/Resources/route_16.png"
                               Width="16" Height="16" Margin="0,0,10,0"/>
                        <TextBlock Text="MEP Auto Routing" FontSize="12" Foreground="{StaticResource Fg.Default}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Width="420" Height="24" CornerRadius="6"
                            Background="#2A2A2A" BorderBrush="#3C3C3C" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="12"
                                       Foreground="{StaticResource Fg.Muted}" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Fg.Muted}" TextTrimming="CharacterEllipsis" MaxWidth="360">
                                <Run Text="RevitMEP-AutoRouting"/><Run Text="  ·  "/><Run Text="{Binding DocumentTitle, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Content="Route" Style="{StaticResource Btn.Primary}" Click="BtnRoute_Click"
                                MinHeight="22" Height="22" Padding="10,0" FontSize="12" Margin="0,0,10,0"
                                VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Create route (Ctrl+Enter)"/>
                        <Button Content="&#xE718;" Style="{StaticResource Btn.Caption}" Click="Pin_Click"
                                x:Name="PinButton" ToolTip="Keep on top" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE921;" Style="{StaticResource Btn.Caption}" Click="Minimize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource Btn.Caption}" Click="Maximize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource Btn.CaptionClose}" Click="Close_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ WORKBENCH -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="300" MinWidth="220"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== ACTIVITY BAR -->
                <Border Grid.Column="0" Background="{StaticResource Bg.Side}"
                        BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <RadioButton DockPanel.Dock="Top" Style="{StaticResource Activity.Button}"
                                     Content="&#xE8B7;" IsChecked="{Binding IsRoutePane}" ToolTip="Route Setup"/>
                        <RadioButton DockPanel.Dock="Top" Style="{StaticResource Activity.Button}"
                                     Content="&#xE8FD;" Click="OutputActivity_Click" ToolTip="Toggle Output panel (Ctrl+J)" GroupName="Output"/>
                        <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource Activity.Button}"
                                     Content="&#xE713;" IsChecked="{Binding IsSettingsPane}" ToolTip="Settings"/>
                        <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource Activity.Button}"
                                     Content="&#xE946;" IsChecked="{Binding IsAboutPane}" ToolTip="About"/>
                    </DockPanel>
                </Border>

                <!-- ===== SIDE BAR -->
                <Border Grid.Column="1" Background="{StaticResource Bg.Side}"
                        BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- ===== ROUTE SETUP pane ===== -->
                        <DockPanel Visibility="{Binding IsRoutePane, Converter={StaticResource BoolToVis}}">
                            <Grid DockPanel.Dock="Top" Height="35" Margin="20,0,8,0">
                                <TextBlock Text="ROUTE SETUP" Style="{StaticResource Text.SectionHeader}" FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="&#xE72C;" Style="{StaticResource Btn.Icon}" Command="{Binding ReloadCommand}" ToolTip="Reload types from model"/>
                                    <Button Content="&#xE894;" Style="{StaticResource Btn.Icon}" Command="{Binding ClearCommand}" ToolTip="Clear selection"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- CONNECTORS -->
                                    <Expander Header="CONNECTORS" Style="{StaticResource Section.Expander}">
                                        <StackPanel>
                                            <Border Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Default}"
                                                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Source.Dot}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="SOURCE" Style="{StaticResource Text.SectionHeader}"/>
                                                        </StackPanel>
                                                        <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Secondary}"
                                                                Command="{Binding PickSourceCommand}" MinHeight="22" Padding="8,1" FontSize="12">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE707;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,5,0"/>
                                                                <TextBlock Text="Pick"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                    <Grid>
                                                        <ContentControl Content="{Binding Source}" ContentTemplate="{StaticResource ConnectorCard}"/>
                                                        <TextBlock Text="No connector picked" FontStyle="Italic">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>

                                            <Button Content="&#xE8AB;" Style="{StaticResource Btn.Icon}" HorizontalAlignment="Center"
                                                    Margin="0,4" Command="{Binding SwapCommand}" ToolTip="Swap source / target">
                                                <Button.LayoutTransform><RotateTransform Angle="90"/></Button.LayoutTransform>
                                            </Button>

                                            <Border Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Default}"
                                                    BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Target.Dot}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="TARGET" Style="{StaticResource Text.SectionHeader}"/>
                                                        </StackPanel>
                                                        <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Secondary}"
                                                                Command="{Binding PickTargetCommand}" MinHeight="22" Padding="8,1" FontSize="12">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE707;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,5,0"/>
                                                                <TextBlock Text="Pick"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                    <Grid>
                                                        <ContentControl Content="{Binding Target}" ContentTemplate="{StaticResource ConnectorCard}"/>
                                                        <TextBlock Text="No connector picked" FontStyle="Italic">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Target}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <!-- SYSTEM -->
                                    <Expander Header="SYSTEM" Style="{StaticResource Section.Expander}">
                                        <StackPanel>
                                            <TextBlock Text="Discipline" Style="{StaticResource Text.Label}"/>
                                            <ComboBox ItemsSource="{Binding Disciplines}" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedDiscipline}"/>

                                            <TextBlock Style="{StaticResource Text.Label}">
                                                <Run Text="{Binding DisciplineLabel, Mode=OneWay}"/><Run Text=" Type"/>
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>

                                            <StackPanel Visibility="{Binding HasSystemTypes, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="System Type" Style="{StaticResource Text.Label}"/>
                                                <ComboBox ItemsSource="{Binding SystemTypes}" SelectedItem="{Binding SelectedSystemType}"/>
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource Text.Label}">
                                                <Run Text="{Binding DisciplineLabel, Mode=OneWay}"/><Run Text=" Size (mm)"/>
                                            </TextBlock>
                                            <CheckBox Content="Match source connector" IsChecked="{Binding MatchSize}" Margin="0,2,0,4"/>
                                            <Grid IsEnabled="{Binding IsSizeInputEnabled}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="96"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding PipeSizeText, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Nominal diameter in mm. Values not in the type's size list snap to the nearest size."/>
                                                <ComboBox Grid.Column="1" Margin="6,0,0,0"
                                                          ItemsSource="{Binding AvailableSizes}"
                                                          SelectedItem="{Binding SelectedListSize}"
                                                          ToolTip="Sizes available for the selected type"/>
                                            </Grid>

                                            <TextBlock Text="Reference Level" Style="{StaticResource Text.Label}"/>
                                            <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- SLOPE -->
                                    <Expander Header="SLOPE" Style="{StaticResource Section.Expander}">
                                        <StackPanel>
                                            <CheckBox Content="Apply slope" IsChecked="{Binding SlopeEnabled}" Margin="0,4"
                                                      ToolTip="Turned on automatically for gravity systems (Sanitary, Storm, …)"/>
                                            <StackPanel IsEnabled="{Binding SlopeEnabled}">
                                                <TextBlock Text="Gradient" Style="{StaticResource Text.Label}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="96"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding SlopeValue, UpdateSourceTrigger=LostFocus}"/>
                                                    <ComboBox Grid.Column="1" Margin="6,0,0,0" SelectedValue="{Binding SlopeUnit}" SelectedValuePath="Tag">
                                                        <ComboBoxItem Content="1 : N" Tag="{x:Static app:SlopeUnit.Ratio}"/>
                                                        <ComboBoxItem Content="%"     Tag="{x:Static app:SlopeUnit.Percent}"/>
                                                    </ComboBox>
                                                </Grid>
                                                <TextBlock Text="{Binding SlopeText}" Style="{StaticResource Text.Muted}" Margin="0,4"/>

                                                <TextBlock Text="Flow direction" Style="{StaticResource Text.Label}"/>
                                                <ComboBox SelectedValue="{Binding SlopeFlow}" SelectedValuePath="Tag">
                                                    <ComboBoxItem Content="Source → Target" Tag="{x:Static app:FlowDirection.SourceToTarget}"/>
                                                    <ComboBoxItem Content="Target → Source" Tag="{x:Static app:FlowDirection.TargetToSource}"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- CALCULATION BOUNDARY（手動 Pick，類型自動判斷） -->
                                    <Expander Header="CALCULATION BOUNDARY" Style="{StaticResource Section.Expander}">
                                        <StackPanel>
                                            <Border Background="{StaticResource Bg.Card}" BorderBrush="{StaticResource Border.Default}"
                                                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE81E;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0"/>
                                                            <TextBlock Text="SPACE / ROOM / MASS" Style="{StaticResource Text.SectionHeader}"/>
                                                        </StackPanel>
                                                        <Button HorizontalAlignment="Right" Content="&#xE711;" Style="{StaticResource Btn.Icon}"
                                                                Command="{Binding ClearBoundaryCommand}" ToolTip="Clear boundary"
                                                                Visibility="{Binding HasBoundary, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Style="{StaticResource Btn.Secondary}" Command="{Binding PickBoundaryCommand}"
                                                                MinHeight="22" Padding="8,1" FontSize="12" Margin="0,0,6,0"
                                                                ToolTip="Pick a Space, Room or Mass in the host model">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE707;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,5,0"/>
                                                                <TextBlock Text="Pick"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource Btn.Secondary}" Command="{Binding PickLinkedBoundaryCommand}"
                                                                MinHeight="22" Padding="8,1" FontSize="12"
                                                                ToolTip="Pick a Space, Room or Mass in a linked model">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE71B;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,5,0"/>
                                                                <TextBlock Text="Pick linked"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding BoundaryText}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding BoundaryText}" Foreground="{StaticResource Fg.Bright}"/>
                                                        <TextBlock Text="{Binding BoundaryDetailText}" Style="{StaticResource Text.Muted}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <CheckBox Content="Keep wall clearance at boundary" IsChecked="{Binding ClearanceOnBoundary}"
                                                      IsEnabled="{Binding HasBoundary}" Margin="0,8,0,0"/>

                                            <TextBlock Text="Wall clearance (mm)" Style="{StaticResource Text.Label}" Margin="0,10,0,0"/>
                                            <TextBox Text="{Binding WallClearanceMm, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Clear distance from wall face to pipe outside (0 – 2000 mm)"/>
                                            <TextBlock Text="Region margin (mm)" Style="{StaticResource Text.Label}" Margin="0,10,0,0"/>
                                            <TextBox Text="{Binding RegionMarginMm, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Extra margin around the route region used for wall collection and one A* retry (0 – 20000 mm, default 2000)"/>
                                            <CheckBox Content="Include linked model walls" IsChecked="{Binding IncludeLinkWalls}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Expander>

                                    <!-- SUMMARY -->
                                    <Expander Header="SUMMARY" Style="{StaticResource Section.Expander}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Segments" Style="{StaticResource Text.Muted}" Margin="0,2"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SegmentCount}" FontFamily="{StaticResource Font.Mono}"/>
                                            <TextBlock Grid.Row="1" Text="Total length" Style="{StaticResource Text.Muted}" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalLengthText}" FontFamily="{StaticResource Font.Mono}"/>
                                            <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource Text.Muted}" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeSummaryText}" FontFamily="{StaticResource Font.Mono}"/>
                                            <TextBlock Grid.Row="3" Text="Slope" Style="{StaticResource Text.Muted}" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SlopeText}" FontFamily="{StaticResource Font.Mono}"/>
                                            <TextBlock Grid.Row="4" Text="Total fall" Style="{StaticResource Text.Muted}" Margin="0,2"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalFallText}" FontFamily="{StaticResource Font.Mono}"/>
                                            <TextBlock Grid.Row="5" Text="Boundary" Style="{StaticResource Text.Muted}" Margin="0,2"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BoundarySummaryText}" FontFamily="{StaticResource Font.Mono}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="160" ToolTip="{Binding BoundaryText}"/>
                                            <TextBlock Grid.Row="6" Text="Problems" Style="{StaticResource Text.Muted}" Margin="0,2"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProblemSummary}" FontFamily="{StaticResource Font.Mono}"
                                                       Foreground="{StaticResource Log.Warn}"/>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- ===== SETTINGS pane ===== -->
                        <DockPanel Visibility="{Binding IsSettingsPane, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Top" Text="SETTINGS" Style="{StaticResource Text.SectionHeader}" FontWeight="Normal"
                                       Height="35" Padding="20,11,0,0"/>
                            <StackPanel Margin="20,6,16,0">
                                <CheckBox IsChecked="{Binding SuppressWarnings}" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="Suppress Revit warnings"/>
                                        <TextBlock Text="Delete warning dialogs during routing. Errors are still reported in PROBLEMS." Style="{StaticResource Text.Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding SelectAfterRoute}" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="Select created elements"/>
                                        <TextBlock Text="Highlight new segments and fittings in Revit." Style="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding Topmost}" Margin="0,6">
                                    <StackPanel>
                                        <TextBlock Text="Keep window on top"/>
                                        <TextBlock Text="Stay above the Revit window." Style="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Button Content="Reset to defaults" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left"
                                        Margin="0,16,0,0" Command="{Binding ResetCommand}"/>
                                <TextBlock Text="Settings are saved to %AppData%\MEPAutoRouting\settings.json when the window closes."
                                           Style="{StaticResource Text.Muted}" Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- ===== ABOUT pane ===== -->
                        <DockPanel Visibility="{Binding IsAboutPane, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Top" Text="ABOUT" Style="{StaticResource Text.SectionHeader}" FontWeight="Normal"
                                       Height="35" Padding="20,11,0,0"/>
                            <StackPanel Margin="20,6,16,0">
                                <TextBlock Text="MEP Auto Routing" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Fg.Bright}"/>
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0">
                                    <Run Text="Version "/><Run Text="{Binding AppVersion, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RevitVersion, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Text="PUBLISHER" Style="{StaticResource Text.SectionHeader}" Margin="0,18,0,6"/>
                                <Grid TextElement.FontSize="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                    <TextBlock Text="Company" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Static app:AppInfo.Publisher}" Foreground="{StaticResource Fg.Bright}"/>
                                    <TextBlock Grid.Row="1" Text="Author" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static app:AppInfo.Author}" Foreground="{StaticResource Fg.Bright}"/>
                                </Grid>

                                <TextBlock Text="WORKFLOW" Style="{StaticResource Text.SectionHeader}" Margin="0,18,0,6"/>
                                <TextBlock Style="{StaticResource Text.Muted}" LineHeight="20" TextWrapping="Wrap"><Run Text="1. Choose discipline, type, size and level"/><LineBreak/><Run Text="2. Pick SOURCE and TARGET connectors"/><LineBreak/><Run Text="3. Optional: pick a Space / Room / Mass as boundary"/><LineBreak/><Run Text="4. Preview the path, check PROBLEMS"/><LineBreak/><Run Text="5. Route – one undo step in Revit"/></TextBlock>
                                <TextBlock Text="SHORTCUTS" Style="{StaticResource Text.SectionHeader}" Margin="0,18,0,6"/>
                                <Grid TextElement.FontSize="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                    <TextBlock Text="F5" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Fg.Link}"/>
                                    <TextBlock Grid.Column="1" Text="Preview" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Row="1" Text="Ctrl+Enter" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Fg.Link}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Route" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Row="2" Text="Ctrl+1 / 2" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Fg.Link}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Pick source / target" Style="{StaticResource Text.Muted}"/>
                                    <TextBlock Grid.Row="3" Text="Ctrl+J" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource Fg.Link}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Toggle panel" Style="{StaticResource Text.Muted}"/>
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="2" Style="{StaticResource Sash}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                <!-- ===== EDITOR + PANEL -->
                <Grid Grid.Column="3" x:Name="EditorGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="200"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition x:Name="PanelRow" Height="210" MinHeight="0"/>
                    </Grid.RowDefinitions>

                    <TabControl Style="{StaticResource Editor.TabControl}" SelectedIndex="{Binding SelectedEditorTab}">

                        <!-- ROUTING OPTIONS -->
                        <TabItem Style="{StaticResource Editor.TabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Fg.Link}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Routing Options"/>
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0" Padding="24,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn.Primary}" Click="BtnRoute_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="Route"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Secondary}" Click="BtnPreview_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE890;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Preview"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Clear" Style="{StaticResource Btn.Secondary}" Command="{Binding ClearCommand}"/>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="24,16,24,16" MaxWidth="720" HorizontalAlignment="Left">
                                        <TextBlock Text="Routing" FontSize="22" Foreground="{StaticResource Fg.Bright}" Margin="0,0,0,14"/>

                                        <TextBlock Style="{StaticResource Text.SettingTitle}"><Run Text="Routing: " Foreground="{StaticResource Fg.Muted}"/><Run Text="Lead Length"/></TextBlock>
                                        <TextBlock Text="Straight run (mm) out of each connector before the first turn." Style="{StaticResource Text.Muted}" Margin="0,4,0,6"/>
                                        <TextBox Text="{Binding LeadMm, UpdateSourceTrigger=LostFocus}" Width="160" HorizontalAlignment="Left"/>

                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Margin="0,22,0,0"><Run Text="Routing: " Foreground="{StaticResource Fg.Muted}"/><Run Text="Minimum Segment Length"/></TextBlock>
                                        <TextBlock Text="Segments shorter than this (mm) are flagged in PROBLEMS – elbows usually fail." Style="{StaticResource Text.Muted}" Margin="0,4,0,6"/>
                                        <TextBox Text="{Binding MinSegmentMm, UpdateSourceTrigger=LostFocus}" Width="160" HorizontalAlignment="Left"/>

                                        <TextBlock Text="Fittings &amp; Connection" FontSize="16" Foreground="{StaticResource Fg.Bright}" Margin="0,28,0,10"/>

                                        <TextBlock Style="{StaticResource Text.SettingTitle}"><Run Text="Fittings: " Foreground="{StaticResource Fg.Muted}"/><Run Text="Auto Elbows"/></TextBlock>
                                        <CheckBox IsChecked="{Binding AddFittings}" Margin="0,6,0,0">
                                            <TextBlock Text="Insert elbows at every turn (uses type routing preferences)." Style="{StaticResource Text.Muted}"/>
                                        </CheckBox>

                                        <TextBlock Style="{StaticResource Text.SettingTitle}" Margin="0,18,0,0"><Run Text="Connection: " Foreground="{StaticResource Fg.Muted}"/><Run Text="Connect Ends"/></TextBlock>
                                        <CheckBox IsChecked="{Binding ConnectEnds}" Margin="0,6,0,0">
                                            <TextBlock Text="Connect the first / last segment to the picked connectors." Style="{StaticResource Text.Muted}"/>
                                        </CheckBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <!-- PATH PREVIEW -->
                        <TabItem Style="{StaticResource Editor.TabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{StaticResource Log.Info}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Path Preview"/>
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1" Padding="24,8,24,6">
                                    <Grid TextElement.Foreground="{StaticResource Fg.Muted}" TextElement.FontSize="11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#"/>
                                        <TextBlock Grid.Column="1" Text="X (mm)"/>
                                        <TextBlock Grid.Column="2" Text="Y (mm)"/>
                                        <TextBlock Grid.Column="3" Text="Z (mm)"/>
                                        <TextBlock Grid.Column="4" Text="SEGMENT (mm)"/>
                                        <TextBlock Grid.Column="5" Text="DIRECTION"/>
                                    </Grid>
                                </Border>
                                <Grid>
                                    <ListBox Style="{StaticResource Flat.ListBox}" ItemsSource="{Binding PreviewPoints}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="24,4" TextElement.FontFamily="{StaticResource Font.Mono}" TextElement.FontSize="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Index}" Foreground="{StaticResource Fg.Dim}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding X}" Foreground="#B5CEA8"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Y}" Foreground="#B5CEA8"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Z}" Foreground="#B5CEA8"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Segment}" Foreground="#CE9178"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Direction}" Foreground="#9CDCFE"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewPoints.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE890;" Style="{StaticResource Text.Icon}" FontSize="48" Foreground="#3C3C3C"/>
                                        <TextBlock Text="Pick two connectors and press Preview (F5)" Style="{StaticResource Text.Muted}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Row="1" Style="{StaticResource Sash}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <!-- ===== BOTTOM PANEL ===== -->
                    <Border Grid.Row="2" Background="{StaticResource Bg.Side}" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="35">
                                <TabControl x:Name="PanelTabs" SelectedIndex="{Binding SelectedPanelTab}" Background="Transparent"
                                            BorderThickness="0" Padding="0" Margin="0">
                                    <TabControl.Template>
                                        <ControlTemplate TargetType="TabControl">
                                            <TabPanel IsItemsHost="True" Margin="8,0,0,0"/>
                                        </ControlTemplate>
                                    </TabControl.Template>
                                    <TabItem Style="{StaticResource Panel.TabItem}">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PROBLEMS" VerticalAlignment="Center"/>
                                                <Border Background="#616161" CornerRadius="8" Padding="6,0" Margin="6,0,0,0" MinWidth="18">
                                                    <TextBlock Text="{Binding ProblemCount}" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem Header="OUTPUT" Style="{StaticResource Panel.TabItem}"/>
                                </TabControl>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <Border Background="{StaticResource Bg.Input}" BorderBrush="{StaticResource Border.Input}" BorderThickness="1"
                                            Height="22" Padding="8,0" Margin="0,0,8,0" CornerRadius="2">
                                        <TextBlock Text="MEP Auto Routing" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Fg.Default}"/>
                                    </Border>
                                    <Button Content="&#xE8C8;" Style="{StaticResource Btn.Icon}" Command="{Binding CopyLogCommand}" ToolTip="Copy output"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource Btn.Icon}" Command="{Binding ClearLogCommand}" ToolTip="Clear output"/>
                                    <Button Content="&#xE70D;" Style="{StaticResource Btn.Icon}" Click="TogglePanel_Click" ToolTip="Hide panel (Ctrl+J)"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <ListBox x:Name="ProblemsList" ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource ProblemLine}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource Flat.ListBox}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPanelTab}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                </ListBox>
                                <TextBlock Text="No problems have been detected in the route." Margin="12,6" Style="{StaticResource Text.Muted}">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource NoProblemsVis}">
                                            <Binding Path="SelectedPanelTab"/>
                                            <Binding Path="ProblemCount"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                                <ListBox x:Name="OutputList" ItemsSource="{Binding LogEntries}" ItemTemplate="{StaticResource LogLine}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource Flat.ListBox}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPanelTab}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================================================================ STATUS BAR -->
            <Border Grid.Row="2" Background="{StaticResource Bg.StatusBar}">
                <DockPanel TextElement.Foreground="White" TextElement.FontSize="12">
                    <Border DockPanel.Dock="Left" Background="{StaticResource Bg.StatusRemote}" Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="{Binding RevitVersion}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Status}" Click="ShowProblems_Click" ToolTip="Show problems">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,4,0" Foreground="White"/>
                            <TextBlock Text="{Binding ProblemCount}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisciplineLabel}" Margin="8,0" VerticalAlignment="Center"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                        <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding SizeSummaryText}"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0"><Run Text="Seg "/><Run Text="{Binding SegmentCount, Mode=OneWay}"/></TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding TotalLengthText}"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75" Text="{x:Static app:AppInfo.PublisherDisplay}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BusyIcon" Text="&#xE895;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0" Foreground="White"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
