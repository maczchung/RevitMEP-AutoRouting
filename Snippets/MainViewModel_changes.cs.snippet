// 1) Constructor：刪除 InitConstraintUi()（已改由 MainWindow.Loaded 觸發）
public MainViewModel(UIApplication uiapp, RevitActionQueue queue /* ... */)
{
    // ... 原本 code ...
    ActionQueue = queue;
    // InitConstraintUi();   ← 刪除呢行
}

// 2) Log()：確保喺 UI thread 加入 LogEntries；如果唔係就 BeginInvoke
public void Log(Routing.LogLevel level, string message)
{
    void add() => LogEntries.Add(new LogEntry(level, message));   // 用返你原本 LogEntry 建法
    var d = System.Windows.Application.Current?.Dispatcher ?? _uiDispatcher;
    if (d.CheckAccess()) add();
    else d.BeginInvoke(new Action(add));
}

// 3) 刪除 VM 入面任何 `ActionQueue.Log += ...` / `_queue.Log += ...`
