// ===== Core/AutoRoutingCommand.cs：Execute 入面訂閱 queue.Log 嗰段換成咁 =====
// Journal 顯示 crash stack：RevitActionQueue.Execute → AutoRoutingCommand lambda → vm.Log
// → LogEntries.Add → ScrollIntoView → throw。以下兩點避免再發生：
//  ① 用 BeginInvoke（非同步），唔好喺 ExternalEvent 入面同步改 ObservableCollection
//  ② 閂 window 時取消訂閱（queue 係 static，唔取消會 call 已閂嘅 VM）

_queue ??= RevitActionQueue.Create();

var vm = new MainViewModel(uiapp, _queue);     // 對返你原本 constructor 參數
var window = new MainWindow(vm);

Action<string> onLog = text =>
{
    try
    {
        window.Dispatcher.BeginInvoke(new Action(() =>
        {
            try { vm.Log(Routing.LogLevel.Error, text); }
            catch (Exception ex) { RevitActionQueue.WriteErrorFile("vm.Log failed – " + ex.Message, ex); }
        }));
    }
    catch { /* window 已閂 */ }
};
_queue.Log += onLog;

window.Closed += (_, _) =>
{
    _queue.Log -= onLog;
    _window = null;
};

new System.Windows.Interop.WindowInteropHelper(window).Owner = uiapp.MainWindowHandle;
_window = window;
window.Show();
return Result.Succeeded;

// ⚠ 如果 VM 入面都有 `_queue.Log += ...`（例如 v3 snippet 嘅 OnQueueLog），刪咗佢，
//   只保留呢度一個訂閱，否則每條 log 會出兩次。
