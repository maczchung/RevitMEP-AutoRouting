// ===== 加入 MainViewModel.cs（同一個 partial class）=====
// 將 property 名 / 類型對返你 VM 實際用嘅。

// 1) class 聲明加 partial
public partial class MainViewModel : /* 你原本嘅 base class */

// 2) 6 個 hook（Constraints.cs 4 個 + Route.cs 2 個）
private partial void Notify(string propertyName) => OnPropertyChanged(propertyName);   // 改返你 base class 嘅 method 名

private partial ElementId GetSelectedTypeId()
    => SelectedType?.Id ?? ElementId.InvalidElementId;           // wrapper：SelectedType?.Element?.Id

private partial bool IsConduitDiscipline()
    => SelectedDiscipline == Discipline.Conduit;                 // 改返你 enum 名

private partial PipingSystemType GetSelectedPipingSystemType()
    => SelectedSystemType as PipingSystemType;                   // wrapper：SelectedSystemType?.Element as PipingSystemType

private partial RouteRequest BuildRouteRequest(bool commit, IRoutingBoundary boundary,
                                               PipeSizeInfo? size, List<RouteProblem> preChecks)
    => new RouteRequest
    {
        Source           = Source?.Connector,                    // connector card wrapper 入面嘅 Revit Connector
        Target           = Target?.Connector,
        PipeTypeId       = GetSelectedTypeId(),
        SystemTypeId     = GetSelectedPipingSystemType()?.Id,
        LevelId          = SelectedLevel?.Id,
        Discipline       = IsConduitDiscipline() ? RouteDiscipline.Conduit : RouteDiscipline.Pipe,
        Options          = ConstraintOptions,
        Boundary         = boundary,
        Size             = size,
        PreChecks        = preChecks,
        MinSegmentMm     = MinSegmentMm,
        SuppressWarnings = SuppressWarnings,
        AddFittings      = AddFittings,
        ConnectEnds      = ConnectEnds,
        Commit           = commit,
    };

private partial void ApplyRouteResult(RouteResult r)
{
    // 用返你原本更新 UI 嘅 code，例如：
    PreviewPoints.Clear();
    // foreach (...) PreviewPoints.Add(new PreviewPointVm(...));   ← 由 r.Path 建
    Problems.Clear();
    foreach (RouteProblem p in r.Problems) Problems.Add(p);
    // SegmentCount / TotalLengthText / TotalFallText / ProblemSummary / ProblemCount → OnPropertyChanged
    SelectedEditorTab = 1;                                       // 轉去 Path Preview
}

// 3) Constructor 最尾
ActionQueue = queue;          // constructor 收到嘅 RevitActionQueue
InitConstraintUi();

// 4) Commands
RouteCommand   = new Shared.RelayCommand(() => ExecuteRoute(true),  () => RouteBlockedReason == null);
PreviewCommand = new Shared.RelayCommand(() => ExecuteRoute(false), () => RouteBlockedReason == null);
// ResetCommand 入面加：ResetConstraintUi();

// 5) LeadMm 要寫入 ConstraintOptions，否則 RouteService 用唔到 UI 輸入
public double LeadMm
{
    get => ConstraintOptions.LeadLengthMm;
    set { ConstraintOptions.LeadLengthMm = value; OnPropertyChanged(); }
}

// 6) 刪除以下已有 member（partial 檔已經有，唔刪會 duplicate）：
//    SlopeText, BoundaryText, OnSystemTypeChanged, Boundary / _boundary, PickBoundaryCommand
// 7) 唔好再 Raise 舊 RoutingEventHandler
