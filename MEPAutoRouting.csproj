<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>MEPAutoRouting</RootNamespace>
    <AssemblyName>MEPAutoRouting</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Version>1.1.0</Version>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
    <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\2025</RevitAddinsDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
    <None Include="MEPAutoRouting.addin" />
  </ItemGroup>

  <!-- Auto-deploy after Debug build. Close Revit first (DLL is locked while Revit runs). -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinsDir)\MEPAutoRouting" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(RevitAddinsDir)\MEPAutoRouting" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="MEPAutoRouting.addin" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed to $(RevitAddinsDir)\MEPAutoRouting" />
  </Target>
</Project>
