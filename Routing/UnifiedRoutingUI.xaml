<Window x:Class="MEPAutoRouting.Routing.UnifiedRoutingUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unified Routing - Pipe Type + Size"
        Height="500"
        Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Routing Mode" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbMode" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,5,0,5">
            <ComboBoxItem Content="Pipe"/>
            <ComboBoxItem Content="Conduit"/>
        </ComboBox>

        <Label Grid.Row="1" Grid.Column="0" Content="Pipe Type" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbPipeType" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,5,0,5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Pipe Size (mm)" VerticalAlignment="Center"/>
        <TextBox x:Name="txtPipeSize" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,5,0,5" Text="100"/>

        <Button Grid.Row="3" Grid.Column="0" Content="Select Start Connector" Height="30" Margin="0,8,8,5" Click="PickStart_Click"/>
        <TextBlock x:Name="txtStart" Grid.Row="3" Grid.Column="1" Text="Not selected" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>

        <Button Grid.Row="4" Grid.Column="0" Content="Select End Connector" Height="30" Margin="0,8,8,5" Click="PickEnd_Click"/>
        <TextBlock x:Name="txtEnd" Grid.Row="4" Grid.Column="1" Text="Not selected" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>

        <Button Grid.Row="5" Grid.Column="0" Content="Select Host Volume" Height="30" Margin="0,8,8,5" Click="PickVolume_Click"/>
        <TextBlock x:Name="txtVolume" Grid.Row="5" Grid.Column="1" Text="Not selected" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF555555"
                   Text="Host volume only. Pipe Type and Pipe Size are used when Routing Mode = Pipe. Size is diameter in millimetres."/>

        <GroupBox Grid.Row="7" Grid.ColumnSpan="2" Header="Routing Constraints" Margin="0,8,0,0" Padding="6">
            <StackPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Wall clearance (mm)" Width="150" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtWallClearance" Width="80" Text="50" ToolTip="Wall face to pipe outside clearance (0 - 2000 mm)"/>
                </DockPanel>
                <CheckBox x:Name="ChkIncludeLinkWalls" Content="Include linked model walls" IsChecked="True" Margin="0,4,0,0"/>
                <CheckBox x:Name="ChkClearanceOnSpaceBoundary" Content="Keep clearance at space boundary" IsChecked="True" Margin="0,2,0,0"/>
                <TextBlock Text="Routing Space" FontWeight="SemiBold" Margin="0,8,0,2"/>
                <RadioButton x:Name="RbSpaceNone" GroupName="SpaceSrc" Content="No space restriction (use routing volume)" IsChecked="True"/>
                <RadioButton x:Name="RbSpaceHost" GroupName="SpaceSrc" Content="Pick host Space / Room"/>
                <RadioButton x:Name="RbSpaceLink" GroupName="SpaceSrc" Content="Pick linked Space / Room"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Run Routing" Width="120" Height="34" Margin="0,0,10,0" IsDefault="True" Click="Run_Click"/>
            <Button Content="Cancel" Width="80" Height="34" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
