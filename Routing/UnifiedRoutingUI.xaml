<Window x:Class="MEPAutoRouting.Routing.UnifiedRoutingUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unified Routing - EVENT FIX"
        Height="340"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Content="Routing Mode"
               VerticalAlignment="Center"/>

        <ComboBox x:Name="cbMode"
                  Grid.Row="0"
                  Grid.Column="1"
                  Height="26"
                  Margin="0,5,0,5">
            <ComboBoxItem Content="Pipe"/>
            <ComboBoxItem Content="Conduit"/>
        </ComboBox>

        <Button x:Name="btnPickStart"
                Grid.Row="1"
                Grid.Column="0"
                Content="Select Start Connector"
                Height="30"
                Margin="0,8,8,5"
                Click="PickStart_Click"/>

        <TextBlock x:Name="txtStart"
                   Grid.Row="1"
                   Grid.Column="1"
                   Text="Not selected"
                   VerticalAlignment="Center"
                   Foreground="Gray"
                   TextWrapping="Wrap"/>

        <Button x:Name="btnPickEnd"
                Grid.Row="2"
                Grid.Column="0"
                Content="Select End Connector"
                Height="30"
                Margin="0,8,8,5"
                Click="PickEnd_Click"/>

        <TextBlock x:Name="txtEnd"
                   Grid.Row="2"
                   Grid.Column="1"
                   Text="Not selected"
                   VerticalAlignment="Center"
                   Foreground="Gray"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Foreground="#FF555555"
                   Text="Connector mode: click near a connector on a family/MEP curve. If no connector is found, the element LocationPoint is used."/>

        <StackPanel Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button x:Name="btnRun"
                    Content="Run Routing"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Run_Click"/>

            <Button x:Name="btnCancel"
                    Content="Cancel"
                    Width="80"
                    Height="34"
                    IsCancel="True"
                    Click="Cancel_Click"/>

        </StackPanel>
    </Grid>
</Window>